# Root file for local Vite and Docker Compose. Copy to .env and fill in values.
# These values are embedded in the browser build; use only a publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The Edge Function uses SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from
# Supabase's server-side environment. Do not put their values in this file.
